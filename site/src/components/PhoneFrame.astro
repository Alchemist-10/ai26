---
// Phone mockup for the mobile screenshot.
interface Props { class?: string }
const { class: cls } = Astro.props;
---
<div class:list={["relative rounded-[2.4rem] border border-line bg-[#0b0e10] p-2.5 shadow-[0_30px_80px_-30px_rgb(0_0_0/0.6)]", cls]}>
  <div class="relative overflow-hidden rounded-[1.9rem] bg-black">
    <span class="absolute top-2 left-1/2 z-10 h-5 w-20 -translate-x-1/2 rounded-full bg-black" aria-hidden="true"></span>
    <slot />
  </div>
</div>
