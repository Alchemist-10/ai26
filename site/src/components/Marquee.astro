---
// Infinite marquee (after Magic UI Marquee), CSS only. Items render twice;
// the copy is hidden from assistive tech.
interface Props { items: string[]; reverse?: boolean; duration?: string }
const { items, reverse, duration = "48s" } = Astro.props;
---
<div class="marquee" data-reverse={reverse || undefined} style={`--duration:${duration}`}>
  {[0, 1].map((copy) => (
    <ul class="marquee__track m-0 list-none p-0" aria-hidden={copy ? "true" : undefined}>
      {items.map((t) => (
        <li class="flex shrink-0 items-center gap-2 rounded-full border border-line bg-card px-4 py-2 text-sm whitespace-nowrap text-muted-fg">
          <span class="size-1.5 rounded-full bg-primary/70"></span>{t}
        </li>
      ))}
    </ul>
  ))}
</div>
