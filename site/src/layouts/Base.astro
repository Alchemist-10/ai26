---
import "@fontsource/noto-sans/400.css";
import "@fontsource/noto-sans/500.css";
import "@fontsource/noto-sans/700.css";
import "@fontsource/noto-sans-mono/400.css";
import "../styles/global.css";
const REPO = "https://github.com/moneytosms/ai26";

interface Props {
  title: string;
  description: string;
}
const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, "");
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta name="theme-color" content="#f5fafa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0b141a" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved theme before first paint. No saved choice: follow the OS.
      try {
        const t = localStorage.getItem("sakshi-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      document.documentElement.classList.add("js");
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header glass">
      <div class="site-header__inner">
        <a class="brand" href={`${base}/`} aria-label="Sakshi home">
          <span class="brand__mark" aria-hidden="true">
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M4 9V4h5M15 4h5v5M20 15v5h-5M9 20H4v-5" /><circle cx="12" cy="12" r="2.5" fill="currentColor" />
            </svg>
          </span>
          <span>Sakshi</span>
        </a>
        <nav aria-label="Primary" class="site-nav">
          <a href={`${base}/#story`}>Story</a>
          <a href={`${base}/present`}><span class="nav-long">Presentation</span><span class="nav-short">Slides</span></a>
          <a href={REPO} rel="noopener">Source</a>
          <button class="theme-toggle" type="button" aria-label="Switch colour theme" data-theme-toggle>
            <svg class="i-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="i-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
          </button>
        </nav>
      </div>
    </header>

    <main id="main" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="site-footer__inner">
        <p>
          Sakshi is an academic project. Plates and vehicles drawn on this site are synthetic; no plate string or
          private frame from the project footage is reproduced here.
        </p>
        <p class="site-footer__links">
          <a href={`${base}/present`}>Slides</a>
          <a href={REPO}>Source on GitHub</a>
        </p>
      </div>
    </footer>

    <script>
      const root = document.documentElement;
      document.querySelector("[data-theme-toggle]")?.addEventListener("click", () => {
        const dark = root.dataset.theme
          ? root.dataset.theme === "dark"
          : matchMedia("(prefers-color-scheme: dark)").matches;
        const next = dark ? "light" : "dark";
        root.dataset.theme = next;
        try { localStorage.setItem("sakshi-theme", next); } catch {}
      });
    </script>
  </body>
</html>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-width: 0 0 1px;
    border-radius: 0;
    box-shadow: none;
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    max-width: calc(var(--wide) + var(--content-start));
    margin: 0 auto;
    padding: 0.7rem var(--gutter);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--foreground);
    font-weight: 700;
    font-size: 1.1rem;
    text-decoration: none;
  }
  .brand:hover { color: var(--foreground); }
  .brand__mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: var(--primary);
    color: var(--primary-foreground);
    box-shadow: 0 8px 16px -8px var(--shadow-ink);
  }
  .site-nav { display: flex; align-items: center; gap: 0.25rem; }
  .site-nav a {
    padding: 0.5rem 0.7rem;
    border-radius: 999px;
    color: var(--muted-foreground);
    text-decoration: none;
    font-size: 0.95rem;
    font-weight: 500;
  }
  .site-nav a:hover, .site-nav a[aria-current="page"] { color: var(--foreground); background: var(--muted); }
  .theme-toggle {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-left: 0.25rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    background: var(--card);
    color: var(--foreground);
    cursor: pointer;
  }
  .i-moon { display: none; }
  :global(html:not(.js)) .theme-toggle { display: none; }
  :global(:root[data-theme="dark"]) .i-sun { display: none; }
  :global(:root[data-theme="dark"]) .i-moon { display: block; }
  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .i-sun { display: none; }
    :global(:root:not([data-theme="light"])) .i-moon { display: block; }
  }
  main:focus { outline: none; }
  .site-footer {
    border-top: 1px solid var(--border);
    margin-top: 6rem;
    padding: 2.5rem var(--gutter);
    color: var(--muted-foreground);
    font-size: 0.92rem;
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem 2rem;
    max-width: calc(var(--wide) + var(--content-start));
    margin: 0 auto;
  }
  .site-footer__inner p { max-width: 60ch; }
  .site-footer__links { display: flex; gap: 1.25rem; }
  .nav-short { display: none; }
  @media (max-width: 480px) {
    .site-nav a[href^="http"] { display: none; }
    .nav-long { display: none; }
    .nav-short { display: inline; }
    .site-nav a { padding: 0.5rem 0.55rem; }
  }
</style>
