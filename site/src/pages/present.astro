---
// Sakshi, the presentation. Story first, then method, then measurements and their limits.
// Every number comes from report/report.md (profile 18 Oct 2026, benchmark 14 Oct 2026),
// its figure sources in report/figs, or repo counts (47 test files, 442 tests, 55 API routes).
// Plate strings, scores and hashes on story slides are synthetic and labelled so.
// Keys: arrows/space, N notes, O overview, F fullscreen, T theme, ? help. ?print renders every slide built.
import "@fontsource/noto-sans/400.css";
import "@fontsource/noto-sans/500.css";
import "@fontsource/noto-sans/700.css";
import "@fontsource/noto-sans-mono/400.css";
import "@fontsource/noto-sans-mono/600.css";
import "../styles/global.css";
import "../deck/deck.css";
import Clip from "../deck/Clip.astro";
import Frame from "../deck/Frame.astro";
import { hasClip } from "../deck/clips";

const REPO = "https://github.com/moneytosms/ai26";
const base = import.meta.env.BASE_URL.replace(/\/$/, "");

const shots = import.meta.glob<{ default: ImageMetadata }>("../assets/screens/*.png", { eager: true });
const shot = (n: string) => shots[`../assets/screens/${n}.png`]?.default;
const dash = shot("dashboard-overview");
const query = shot("query");
const congestion = shot("congestion");
const strip = [
  ["camera-settings", "Camera settings", "Audited metadata revisions. Calibration marked unverified."],
  ["timeline", "Evidence timeline", "Real YOLOv8 detections for one camera, track-local."],
  ["investigation", "Rule alerts", "Watchlists, zones, dwell rules, a durable escalation queue."],
] as const;
const stripShots = strip.map(([n, t, d]) => ({ src: shot(n), t, d })).filter((s) => s.src);
const appClips = ["app-live", "app-query"].filter(hasClip);

const team = [
  ["A S Sri Dathan", "2024BCS0091"],
  ["Akshay V.S", "2024BCD0015"],
  ["Bharadwaj B Chand", "2024BCS0059"],
  ["Shivansh Neekhra", "2024BCS0023"],
  ["Srimoneyshankar Ajith", "2024BCS0055"],
];

// Cold-open city grid. The car follows `route` in 5 s; route cameras fire when it passes.
const streetsX = [100, 260, 420, 580, 740, 900, 1060, 1220];
const streetsY = [100, 230, 360, 490, 620];
const route = "M100 620 H420 V490 H740 V360 H1060 V230 H1240";
const routeCams = [
  { x: 260, y: 620, id: "CAM-14", t: 0.52, tc: "18:02:14", px: 60, py: 480 },
  { x: 580, y: 490, id: "CAM-22", t: 1.99, tc: "18:04:51", px: 430, py: 360 },
  { x: 900, y: 360, id: "CAM-31", t: 3.46, tc: "18:07:09", px: 750, py: 230 },
  { x: 1060, y: 230, id: "CAM-40", t: 4.41, tc: "18:08:37", px: 1040, py: 98 },
];
const cityCams = streetsX.flatMap((x, i) => streetsY.map((y, j) => ({ x, y, k: i * 5 + j })))
  .filter((c) => (c.k * 7) % 3 !== 0 && !routeCams.some((r) => r.x === c.x && r.y === c.y));

const trackA = [
  ["KL07AB1234", "0.61", "ok"],
  ["KL07AB1Z34", "0.44", "ok"],
  ["KL01AB1234", "0.52", "ok"],
];
const trackB = [
  ["KL07CD5678", "0.58", "ok"],
  ["KL07CD5678", "0.29", "low"],
  ["KL07CD5678", "0.47", "ok"],
  ["KL07CD5678", "0.66", "ok"],
];

const gates = [
  ["Confidence", "OCR score at least 0.35.", "≥ 0.35"],
  ["Format", "Normalised to Indian registration syntax. Raw text and every edit kept.", "valid syntax"],
  ["Clean track", "Reads from an ambiguous track never count.", "not ambiguous"],
  ["Consensus", "3 consistent reads among the last 8, same camera, same track.", "3 of 8"],
];

const literature = [
  ["YOLO", "Redmon et al., 2016", "Single-stage real-time detection", "Pretrained YOLOv8n finds vehicles and people"],
  ["SORT", "Bewley et al., 2016", "Motion + global assignment", "Our tracker: assignment with custom motion, geometry, ambiguity rules"],
  ["DeepSORT", "Wojke et al., 2017", "Adds learned appearance", "Comparison only. No appearance model, no re-ID"],
  ["YOLO ALPR", "Laroca et al., 2018", "Detect plate, then read characters", "Our two-stage plate detector + OCR"],
  ["MobileViT v2", "Mehta & Rastegari, 2022/23", "Separable self-attention, linear cost", "The plate OCR backbone"],
  ["INT8", "Jacob et al., 2018", "Integer-only inference", "Our FP32 vs INT8 detector benchmark"],
];

type Node = { id: string; x: number; y: number; w: number; h: number; t: string; s: string[]; at: number; big?: boolean };
const nodes: Node[] = [
  { id: "src", x: 0, y: 170, w: 130, h: 100, t: "Sources", s: ["RTSP or MP4", "camera network"], at: 0 },
  { id: "sch", x: 166, y: 170, w: 150, h: 100, t: "Scheduler", s: ["global budget", "per-camera slots"], at: 0, big: true },
  { id: "det", x: 360, y: 50, w: 170, h: 96, t: "Detector", s: ["YOLOv8n · 640 px"], at: 1 },
  { id: "plt", x: 360, y: 290, w: 170, h: 110, t: "Plate reader", s: ["YOLOv9-tiny · 384", "MobileViT-v2 OCR"], at: 1 },
  { id: "trk", x: 570, y: 50, w: 150, h: 96, t: "Tracker", s: ["camera-local"], at: 2 },
  { id: "con", x: 570, y: 290, w: 150, h: 110, t: "Gates", s: ["3 of last 8", "or abstain"], at: 2 },
  { id: "db", x: 760, y: 170, w: 140, h: 100, t: "SQLite", s: ["WAL · audit", "model hashes"], at: 3, big: true },
  { id: "api", x: 950, y: 50, w: 160, h: 96, t: "FastAPI", s: ["55 routes"], at: 4 },
  { id: "ui", x: 950, y: 180, w: 160, h: 80, t: "Dashboard", s: ["React + TS"], at: 4 },
  { id: "rep", x: 950, y: 290, w: 160, h: 110, t: "Reports", s: ["SHA-256", "opt. Ed25519"], at: 4 },
];
const beams = [
  { d: "M130 220 H166", at: 0 },
  { d: "M316 205 C338 205 338 98 360 98", at: 1 },
  { d: "M316 235 C338 235 338 345 360 345", at: 1, plate: true },
  { d: "M530 98 H570", at: 2 },
  { d: "M530 345 H570", at: 2, plate: true },
  { d: "M720 98 C740 98 740 205 760 205", at: 3 },
  { d: "M720 345 C740 345 740 235 760 235", at: 3, plate: true },
  { d: "M900 205 C925 205 925 98 950 98", at: 4 },
  { d: "M900 220 H950", at: 4 },
  { d: "M900 235 C925 235 925 345 950 345", at: 4 },
];

const ring = Array.from({ length: 9 }, (_, k) => {
  const a = (k / 9) * Math.PI * 2 - Math.PI / 2;
  return { k, x: 230 + Math.cos(a) * 168, y: 220 + Math.sin(a) * 168 };
});

const perCam = { done: [39, 39, 39, 39, 39, 39, 38, 38, 39], over: [2, 2, 4, 3, 7, 1, 36, 37, 39] };
// Relative forward-pass time, ONNX FP32 = 1.00 (report: 92.834 / 95.309 / 55.782 ms medians).
const race = [
  { l: "PyTorch FP32", rel: 92.834 / 95.309, mb: 6.55 },
  { l: "ONNX FP32", rel: 1, mb: 12.82 },
  { l: "ONNX INT8", rel: 55.782 / 95.309, mb: 3.6, win: true },
];

const todayNext = [
  ["End-to-end pipeline ran on the sample feeds with zero failed attempts.", "Labelled, held-out accuracy evaluation for detection, plates and tracking."],
  ["The gates abstained on every mismatched plate read we reviewed.", "Synchronised clocks and verified locations before identity or journey claims."],
  ["INT8 detector export runs about 41% faster than FP32.", "INT8 and accelerated plate inference in the live pipeline."],
  ["Every observation and report is hashed, versioned and auditable.", "Scale-out deployment: workers by camera, networked database."],
];

const projection = [
  { k: "A", l: "Prototype", v: 1.17, m: true },
  { k: "B", l: "+ INT8 detector", v: 1.22 },
  { k: "C", l: "4 workers", v: 4.9 },
  { k: "D", l: "Accelerated", v: 11.7 },
];

const roadmap = [
  ["Now", "Working prototype, exercised on the available sample feeds."],
  ["Label", "Authorised, prediction-blind held-out set, split by vehicle, camera, place, session."],
  ["Measure", "Precision, recall, exact-plate match, with abstention coverage and intervals."],
  ["Adapt", "Fine-tune OCR on licensed regional plates. Promote only after paired evaluation."],
  ["Scale out", "Workers partitioned by camera, accelerated inference, networked database."],
  ["Connect", "Synchronised clocks and verified locations unlock citywide journeys."],
  ["Deploy", "Privacy, legal, retention and security review, then a city pilot."],
];

const faqs = [
  ["How accurate is the plate OCR?", "Not yet measured, and we say so. No held-out labels exist. The 4 readable crops we checked were all misread, and all 4 were rejected."],
  ["Did you train the models?", "No. YOLOv8n, YOLOv9-tiny and MobileViT-v2 are pretrained. Our work is the pipeline that keeps their doubt visible."],
  ["How does it reach city scale?", "Scale out by camera: the scheduler hands camera partitions to workers, and decode, inference and storage scale independently."],
  ["Can it follow a car across the city?", "That is the design. Sightings link into candidate journeys today; identity claims wait for synchronised clocks and verified locations."],
  ["Why not an AI chatbot for search?", "A bounded grammar is predictable and auditable. Unsupported questions are rejected, not guessed."],
  ["Is any plate in this deck real?", "No. Story plates are synthetic. The report reproduces no plate strings or private frames."],
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sakshi, the presentation</title>
    <meta name="description" content="Sakshi: multi-camera vehicle analytics that keeps uncertainty visible. A cinematic click-through deck with speaker notes, overview and print mode." />
    <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
    <script is:inline>
      try {
        const t = localStorage.getItem("sakshi-theme");
        if (t === "light" || t === "dark") document.documentElement.dataset.theme = t;
      } catch {}
      if (new URLSearchParams(location.search).has("print")) document.documentElement.classList.add("print");
    </script>
  </head>
  <body class="present">
    <svg width="0" height="0" style="position:absolute" aria-hidden="true">
      <defs>
        <pattern id="hatch" width="10" height="10" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
          <rect width="10" height="10" class="hatch-bg" />
          <path d="M0 0 V10" class="hatch-line" />
        </pattern>
      </defs>
      <symbol id="i-check" viewBox="0 0 24 24"><path d="M5 12.5l4.5 4.5L19 7.5" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round" /></symbol>
      <symbol id="i-lock" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="9" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M8 11V8a4 4 0 0 1 8 0v3" fill="none" stroke="currentColor" stroke-width="2" /></symbol>
      <symbol id="i-x" viewBox="0 0 24 24"><path d="M6 6l12 12M18 6L6 18" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" /></symbol>
      <symbol id="i-q" viewBox="0 0 24 24"><path d="M9 9a3 3 0 1 1 4.2 2.8c-.8.4-1.2 1-1.2 1.9V15" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" /><circle cx="12" cy="18.5" r="1.2" fill="currentColor" /></symbol>
      <symbol id="i-cam" viewBox="0 0 24 24"><rect x="3" y="7" width="13" height="10" rx="2" fill="none" stroke="currentColor" stroke-width="2" /><path d="M16 11l5-3v8l-5-3" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round" /></symbol>
    </svg>

    <div class="progress" aria-hidden="true"><span id="bar"></span></div>

    <div class="viewport" id="viewport">
      <div class="stage" id="stage">

        <!-- Title -->
        <section class="slide s-title" data-builds="0" aria-label="Sakshi">
          <svg class="finder" viewBox="0 0 560 420" aria-hidden="true">
            <path class="grid3" d="M187 0 V420 M373 0 V420 M0 140 H560 M0 280 H560" />
            <path class="corner" d="M12 72 V12 H72" /><path class="corner" d="M488 12 H548 V72" />
            <path class="corner" d="M548 348 V408 H488" /><path class="corner" d="M72 408 H12 V348" />
            <path class="f-road" d="M40 420 L238 190 H322 L520 420 Z" />
            <path class="f-lane" d="M280 196 V420" />
            <g class="approach">
              <g class="f-car">
                <rect x="190" y="230" width="180" height="120" rx="20" class="fc-body" />
                <rect x="210" y="242" width="140" height="44" rx="8" class="f-glass" />
                <circle cx="214" cy="314" r="11" class="fc-light" /><circle cx="346" cy="314" r="11" class="fc-light" />
                <g class="pix">
                  {Array.from({ length: 12 }, (_, k) => <rect x={248 + (k % 6) * 11} y={322 + Math.floor(k / 6) * 10} width="11" height="10" style={`opacity:${0.35 + ((k * 7) % 5) / 8}`} />)}
                </g>
              </g>
              <rect class="f-box" x="178" y="218" width="204" height="144" rx="4" />
              <text class="f-tag" x="180" y="210">car · tracking</text>
              <rect class="f-pbox" x="242" y="316" width="78" height="30" rx="3" />
            </g>
            <path class="cross" d="M280 120 v24 M280 156 v24 M250 150 h24 M286 150 h24" />
            <rect class="f-scan" x="14" y="14" width="532" height="2" />
            <circle class="f-rec" cx="40" cy="38" r="7" /><text class="f-hud" x="56" y="44">REC</text>
            <text class="f-hud" x="536" y="44" text-anchor="end">CAM-07 · REPLAY 00:04:12</text>
            <text class="f-hud dim" x="40" y="392">pixelated: privacy mode</text>
            <text class="f-hud dim" x="536" y="392" text-anchor="end">citywide grid</text>
          </svg>
          <div class="title-block">
            <p class="kicker">CSE311 · Artificial Intelligence</p>
            <h1 class="glitch" data-text="SAKSHI"><span data-scramble="title">SAKSHI</span></h1>
            <p class="deva"><span lang="sa">साक्षी</span> · <i>witness</i></p>
            <p class="lede">Citywide vehicle analytics that records what it saw, and admits what it could not read.</p>
            <ul class="boot">
              <li>citywide camera grid · one global frame budget</li>
              <li>YOLOv8n · YOLOv9-tiny · MobileViT-v2</li>
              <li>consensus gate armed: 3 of last 8, else abstain</li>
            </ul>
          </div>
          <div class="credits">
            <ul class="team">{team.map(([n, r]) => <li><b>{n}</b><span>{r}</span></li>)}</ul>
            <p class="inst">Guide: Dr. Sreeja M U · Department of CSE, IIIT Kottayam · Third year, 2026–2027</p>
          </div>
          <aside class="notes" hidden>
            <p>Introduce the team in one breath. Sakshi is Sanskrit for <b>witness</b>: a witness says what it saw, and says when it is not sure.</p>
            <p>That sentence is the design. Everything after this shows how the system earns, or refuses, an identity.</p>
          </aside>
        </section>

        <!-- Cold open -->
        <section class="slide s-scene" data-builds="3" data-t="slide" aria-label="One car, a city of cameras">
          <svg class="scene" viewBox="0 0 1280 720" aria-hidden="true">
            {streetsX.map((x) => <path class="street" d={`M${x} 40 V700`} />)}
            {streetsY.map((y) => <path class="street" d={`M40 ${y} H1260`} />)}
            {cityCams.map((c) => <circle class="node-cam" cx={c.x} cy={c.y} r="6" style={`--d:${(c.k % 7) * 0.4}s`} />)}
            <path class="journey rv" data-at="2" d={route} />
            {routeCams.map((c) => (
              <g class="rcam rv" data-at="1" style={`--t:${c.t}s`}>
                <circle class="rcam__ring" cx={c.x} cy={c.y} r="16" />
                <circle class="rcam__dot" cx={c.x} cy={c.y} r="7" />
                <g class="pop">
                  <rect class="mon__frame" x={c.px} y={c.py} width="200" height="112" rx="8" />
                  <path class="mon__road" d={`M${c.px + 40} ${c.py + 112} L${c.px + 88} ${c.py + 40} H${c.px + 112} L${c.px + 160} ${c.py + 112} Z`} />
                  <rect class="mon__car" x={c.px + 76} y={c.py + 62} width="48" height="30" rx="6" />
                  <rect class="mon__box" x={c.px + 70} y={c.py + 56} width="60" height="42" rx="3" />
                  <text class="mon__tag" x={c.px + 70} y={c.py + 51}>car</text>
                  <text class="mon__id" x={c.px + 10} y={c.py + 20}>{c.id}</text>
                  <text class="mon__tc" x={c.px + 190} y={c.py + 20} text-anchor="end">{c.tc}</text>
                </g>
              </g>
            ))}
            <circle class="carpt rv" data-at="1" r="9" style={`offset-path:path('${route}')`} />
            <g class="jlabel rv" data-at="2"><rect x="984" y="252" width="268" height="34" rx="17" /><text x="1118" y="275" text-anchor="middle">candidate journey · 4 sightings</text></g>
          </svg>
          <div class="copy">
            <header class="hd"><p class="kicker">The problem</p><span class="tag i">Illustrative</span></header>
            <h2>One car. A city of cameras. Hours of video.</h2>
            <p class="lede rv" data-at="2">Which cameras saw it, and when?</p>
            <p class="lede rv strong" data-at="3">Hand review does not scale. Blind trust is worse. Sakshi links sightings into journeys a person can review, with the evidence attached.</p>
          </div>
          <aside class="notes" hidden>
            <p>Click once: a car crosses the city. Each camera on its path snaps a detection and a replay timestamp.</p>
            <p>Click twice: the sightings link into a <b>candidate journey</b>. That is the product: citywide sightings, joined for a human to review, never a confident guess.</p>
          </aside>
        </section>

        <!-- Inside one camera -->
        <section class="slide s-cam" data-builds="3" data-t="zoom" aria-label="Inside one camera">
          <div class="copy">
            <header class="hd"><p class="kicker">Inside one camera</p><span class="tag i">Synthetic plate</span></header>
            <h2>See the car. Find the plate. Read it.</h2>
            <ol class="steps">
              <li class="rv" data-at="1"><b>Detect</b><span>YOLOv8n, 640 px input. Cars, motorcycles, buses, trucks, and people for privacy masking.</span></li>
              <li class="rv" data-at="2"><b>Locate</b><span>YOLOv9-tiny plate detector at 384 × 384.</span></li>
              <li class="rv" data-at="3"><b>Read</b><span>MobileViT-v2 OCR via ONNX Runtime. Characters plus confidences.</span></li>
            </ol>
          </div>
          <div class="feed">
            <div class="feed__hud"><span><i class="dot"></i>CAM-07 · track 14</span><span>1920 × 1080 · replay</span></div>
            <svg class="feed__svg" viewBox="0 0 660 340" aria-hidden="true">
              <path class="f-road" d="M60 340 L280 70 H380 L600 340 Z" />
              <path class="f-lane" d="M330 80 V340" />
              <rect x="200" y="96" width="260" height="170" rx="26" class="fc-body" />
              <rect x="226" y="112" width="208" height="62" rx="10" class="f-glass" />
              <circle cx="236" cy="210" r="14" class="fc-light" /><circle cx="424" cy="210" r="14" class="fc-light" />
              <rect x="280" y="222" width="100" height="30" rx="4" class="plate-bg" />
              <text x="330" y="244" text-anchor="middle" class="plate-txt">KL07AB1234</text>
              <rect class="snapbox rv" data-at="1" x="186" y="82" width="288" height="198" rx="4" />
              <text class="snaptag rv" data-at="1" x="188" y="74">car · YOLOv8n</text>
              <rect class="snapbox amber rv" data-at="2" x="272" y="216" width="116" height="42" rx="3" />
              <text class="snaptag amber rv" data-at="2" x="186" y="304">plate · YOLOv9-tiny</text>
            </svg>
            <div class="ocr rv" data-at="3">
              <div class="crop" aria-hidden="true"><span>KL07AB1234</span></div>
              <div class="ocr__out">
                <p class="ocr__lbl">MobileViT-v2 OCR → per-character confidence</p>
                <div class="chars">
                  {"KL07AB1234".split("").map((ch, k) => (
                    <span class="ch" style={`--c:${[0.92, 0.9, 0.71, 0.88, 0.95, 0.83, 0.64, 0.4, 0.86, 0.77][k]}`}><b data-scramble="ch">{ch}</b><i></i></span>
                  ))}
                </div>
              </div>
            </div>
          </div>
          <aside class="notes" hidden>
            <p>Three pretrained models. Click 1: vehicle box. Click 2: plate box. Click 3: the OCR decodes the crop character by character.</p>
            <p>Watch the 8th character: low confidence. One read is never enough, which is the next slide. Plate and scores here are synthetic.</p>
          </aside>
        </section>

        <!-- Consensus vote -->
        <section class="slide s-vote" data-builds="4" data-t="slide" aria-label="Consensus or abstain">
          <header class="hd"><p class="kicker">Per-track consensus</p><span class="tag i">Synthetic plates and scores</span></header>
          <h2>Three reads must agree. Otherwise, abstain.</h2>
          <div class="tracks">
            <div class="track">
              <p class="track__h"><svg class="ic"><use href="#i-cam" /></svg>CAM-07 · track 14</p>
              <div class="reads">
                {trackA.map(([p, c], k) => (
                  <div class="read rv" data-at="1" style={`transition-delay:${k * 0.35}s`}><span>#{k + 1}</span><code data-scramble="plate">{p}</code><b>{c}</b></div>
                ))}
              </div>
              <div class="tally rv" data-at="2">
                <div class="tally__row"><code>KL07AB1234</code><span class="tb" style="--v:1"></span></div>
                <div class="tally__row"><code>KL07AB1Z34</code><span class="tb" style="--v:1"></span></div>
                <div class="tally__row"><code>KL01AB1234</code><span class="tb" style="--v:1"></span></div>
                <span class="thresh"><i>3 needed</i></span>
              </div>
              <div class="stamp bad rv" data-at="2"><svg class="ic"><use href="#i-q" /></svg>Abstain · reads conflict</div>
            </div>
            <div class="track">
              <p class="track__h"><svg class="ic"><use href="#i-cam" /></svg>CAM-08 · track 3</p>
              <div class="reads">
                {trackB.map(([p, c, s], k) => (
                  <div class:list={["read rv", s]} data-at="3" style={`transition-delay:${k * 0.35}s`}><span>#{k + 1}</span><code data-scramble="plate">{p}</code><b>{c}{s === "low" && <em> &lt; 0.35</em>}</b></div>
                ))}
              </div>
              <div class="tally rv" data-at="4">
                <div class="tally__row win"><code>KL07CD5678</code><span class="tb" style="--v:3"></span></div>
                <span class="thresh"><i>3 needed</i></span>
              </div>
              <div class="stamp ok rv" data-at="4"><svg class="ic"><use href="#i-lock" /></svg>Supported · 3 of last 8</div>
            </div>
          </div>
          <aside class="notes" hidden>
            <p>Click 1–2: track 14 gets three different strings. No string reaches three votes, so Sakshi <b>abstains</b>. The raw reads stay for a human.</p>
            <p>Click 3–4: track 3. One read is below 0.35 and never votes. The other three agree, so the plate is supported, scoped to that camera and track only.</p>
          </aside>
        </section>

        <!-- Gates -->
        <section class="slide s-gates" data-builds="4" data-t="slide" aria-label="The plate gates">
          <header class="hd"><p class="kicker">The rule everything rests on</p></header>
          <h2>A plate becomes an identity only when every gate agrees</h2>
          <div class="rail">
            <span class="rail__line"></span>
            <span class="token"><code>read</code></span>
          </div>
          <div class="gates">
            {gates.map(([t, d, p], k) => (
              <div class="gate rv" data-at={k + 1}>
                <span class="gate__n">{k + 1}</span>
                <h3>{t}</h3>
                <p>{d}</p>
                <span class:list={["pill", k === 3 ? "lock" : "ok"]}><svg class="ic"><use href={k === 3 ? "#i-lock" : "#i-check"} /></svg>{p}</span>
              </div>
            ))}
          </div>
          <div class="fails rv" data-at="4">
            <span><svg class="ic"><use href="#i-x" /></svg>Fail any gate: the read stays in history, raw text intact, and is excluded from plate queries.</span>
            <span>Conflicts stay conflicts. Character suggestions are review-only.</span>
          </div>
          <aside class="notes" hidden>
            <p>Each click passes the read through one gate: confidence ≥ 0.35, valid Indian syntax, a non-ambiguous track, then 3-of-8 consensus.</p>
            <p>Key line: a wrong plate is worse than no plate. Failing reads are not deleted; they are kept and labelled.</p>
          </aside>
        </section>

        <!-- What it is -->
        <section class="slide s-plain" data-builds="4" data-t="slide" aria-label="What Sakshi is">
          <header class="hd"><p class="kicker">Introduction</p></header>
          <h2>Sakshi turns multi-camera footage into reviewable, auditable vehicle observations.</h2>
          <div class="roles">
            <div class="role rv" data-at="1"><span class="role__n">01</span><h3>See</h3><p>Pretrained YOLOv8n finds cars, motorcycles, buses and trucks. People too, for masking.</p></div>
            <div class="role rv" data-at="2"><span class="role__n">02</span><h3>Read</h3><p>A plate detector and a MobileViT-v2 OCR propose text. Doubt means abstain.</p></div>
            <div class="role rv" data-at="3"><span class="role__n">03</span><h3>Follow</h3><p>A camera-local tracker links boxes over time by motion and geometry.</p></div>
            <div class="role rv" data-at="4"><span class="role__n">04</span><h3>Witness</h3><p>Every read, model hash, review and export is stored and auditable.</p></div>
          </div>
          <div class="legendbar">
            <span>How to read this deck</span>
            <span class="tag m">Measured</span><span>recorded on our hardware</span>
            <span class="tag p">Projected</span><span>estimate, not tested</span>
            <span class="tag i">Illustrative</span><span>synthetic, for explanation</span>
          </div>
          <aside class="notes" hidden>
            <p>Four verbs: see, read, follow, witness. Pretrained models do the seeing; our contribution is the pipeline that keeps their uncertainty visible.</p>
            <p>Point at the legend: every number from here on carries one of three labels.</p>
          </aside>
        </section>

        <!-- Problem & objectives -->
        <section class="slide s-two" data-builds="2" data-t="slide" aria-label="Problem statement and objectives">
          <div>
            <header class="hd"><p class="kicker">Problem statement</p></header>
            <h2>Too much video. Too little trust in what a model says about it.</h2>
            <ul class="plain">
              <li>Searching every recording by hand is slow and hard to repeat.</li>
              <li>OCR misreads small, blurred plates.</li>
              <li class="rv" data-at="1">A replay timestamp is not when the scene happened.</li>
              <li class="rv" data-at="1">A wrong identity costs more than no identity.</li>
            </ul>
          </div>
          <div>
            <header class="hd"><p class="kicker">Objectives</p></header>
            <ol class="obj">
              <li class="rv" data-at="2"><b>Share</b> One processor samples every camera under a global frame budget.</li>
              <li class="rv" data-at="2"><b>See</b> Pretrained vehicle detection and plate OCR.</li>
              <li class="rv" data-at="2"><b>Doubt</b> Keep raw and ambiguous reads. Abstain on conflict.</li>
              <li class="rv" data-at="2"><b>Follow</b> Camera-local tracking that retires ambiguous tracks.</li>
              <li class="rv" data-at="2"><b>Prove</b> Hashes, audit records, verifiable exports.</li>
              <li class="rv" data-at="2"><b>Review</b> A dashboard with queries, rules and reports.</li>
              <li class="rv" data-at="2"><b>Evaluate</b> Reproducible tools that say what they cannot measure.</li>
            </ol>
          </div>
          <aside class="notes" hidden>
            <p>Problem statement from the report: detect vehicles, propose plates, keep provenance, help review, <b>without</b> turning a low-quality prediction into an identity.</p>
            <p>Seven objectives map onto the pipeline stages. The last one matters: tools that say what they cannot measure.</p>
          </aside>
        </section>

        <!-- Literature -->
        <section class="slide s-plain" data-builds="2" data-t="slide" aria-label="Existing work">
          <header class="hd"><p class="kicker">Literature</p></header>
          <h2>Standing on established methods</h2>
          <div class="lit">
            <div class="lit__row head"><span>Work</span><span>Idea</span><span>Role in Sakshi</span></div>
            {literature.map(([w, c, i, r], k) => (
              <div class="lit__row rv" data-at={k < 3 ? 1 : 2} style={`transition-delay:${(k % 3) * 0.08}s`}>
                <span><b>{w}</b><small>{c}</small></span><span>{i}</span><span>{r}</span>
              </div>
            ))}
          </div>
          <p class="gap rv" data-at="2">Gap we address: a review workflow around uncertain predictions, not a new detector.</p>
          <aside class="notes" hidden>
            <p>We combine known methods rather than invent a detector. YOLO for detection, SORT-style assignment for tracking, YOLO-based ALPR structure, MobileViT-v2 for OCR, INT8 quantisation for speed.</p>
            <p>The gap is the workflow: provenance, audit, abstention. Full references are in the report.</p>
          </aside>
        </section>

        <!-- Architecture -->
        <section class="slide s-plain" data-builds="4" data-t="zoom" aria-label="System architecture">
          <header class="hd"><p class="kicker">System architecture</p></header>
          <h2>Inference is owned once. Everything else reads its output.</h2>
          <svg class="arch" viewBox="-10 30 1130 390" role="img" aria-label="Sources feed one scheduler, which runs a vehicle detector and a plate reader. A tracker and consensus gates feed SQLite, which serves FastAPI, the dashboard and evidence reports.">
            {beams.map((b) => (
              <g class:list={["beam rv", { plate: b.plate }]} data-at={b.at}>
                <path class="beam__base" d={b.d} />
                <path class="beam__flow" d={b.d} />
                <circle class="pk" r="5" style={`offset-path:path('${b.d}');animation-delay:${(b.d.length % 7) * -0.2}s`} />
                <circle class="pk" r="5" style={`offset-path:path('${b.d}');animation-delay:${(b.d.length % 7) * -0.2 - 0.8}s`} />
              </g>
            ))}
            {nodes.map((n) => (
              <g class:list={["node rv", { big: n.big }]} data-at={n.at}>
                <rect x={n.x} y={n.y} width={n.w} height={n.h} rx="12" />
