  /* HUD */
  .hud { position: fixed; left: 50%; bottom: 14px; transform: translateX(-50%); display: flex; gap: 10px; align-items: center; padding: 8px 12px;
    border-radius: 999px; background: var(--glass-fill); border: 1px solid var(--glass-border); backdrop-filter: blur(10px); z-index: 10; transition: opacity 0.4s; }
  .hud.idle { opacity: 0.0; }
  .hud:hover, .hud:focus-within { opacity: 1; }
  .hud__btn { font: inherit; font-size: 15px; font-weight: 500; color: var(--foreground); background: transparent; border: 1px solid var(--border); border-radius: 999px;
    min-height: 40px; min-width: 40px; padding: 0 14px; white-space: nowrap; cursor: pointer; text-decoration: none; display: inline-grid; place-items: center; }
  .hud__btn:hover { background: var(--accent); }
  .hud__btn:focus-visible, .dots button:focus-visible { outline: 3px solid var(--ring); outline-offset: 2px; }
  .dots { display: flex; gap: 2px; list-style: none; margin: 0; padding: 0; }
  .dots button { width: 18px; height: 40px; background: transparent; border: 0; padding: 0; cursor: pointer; position: relative; }
  .dots button::after { content: ""; position: absolute; left: 3px; right: 3px; top: 17px; height: 6px; border-radius: 3px; background: var(--input); transition: background 0.3s, transform 0.3s; }
  .dots button.done::after { background: var(--primary-soft); }
  .dots button.cur::after { background: var(--primary); transform: scaleY(1.4); }
  .count { font-size: 15px; min-width: 52px; text-align: center; color: var(--muted-foreground); font-variant-numeric: tabular-nums; }
  @media (max-width: 760px) { .count, #fs { display: none; } .dots button { width: 10px; } }

  @media (prefers-reduced-motion: reduce) {
    .slide, .rv, .wire, .car, .bar__fill, .hb-r, .pb-r, .sq .x { transition-duration: 0.01ms !important; transition-delay: 0s !important; }
    .lane, .f-lane, .f-scan, .f-rec, .cam-led, .packet, .cone, .snap, .corner, .f-box, .f-tag { animation: none !important; }
    .corner { stroke-dashoffset: 0; }
    .packet { display: none; }
    .f-box, .f-tag { opacity: 1; }
    .snap.on { opacity: 0.6; }
    svg .car.on { transform: translate(560px, 588px); }
  }
</style>

<script>
  const slides = [...document.querySelectorAll<HTMLElement>(".slide")];
  const stage = document.getElementById("stage")!;
  const hud = document.querySelector<HTMLElement>(".hud")!;
  const count = document.getElementById("count")!;
  const dots = [...document.querySelectorAll<HTMLButtonElement>("[data-go]")];
  const total = slides.length;
  const builds = slides.map((s) => Number(s.dataset.builds || 0));

  let i = 0;
  let b = 0;

  const fit = () => {
    const s = Math.min(innerWidth / 1280, innerHeight / 720);
    stage.style.setProperty("--s", String(s));
  };

  const runCount = (el: HTMLElement) => {
    const target = Number(el.dataset.count);
    const dec = Number(el.dataset.dec || 0);
    const t0 = performance.now();
    const step = (t: number) => {
      const k = Math.min(1, (t - t0) / 1100);
      const v = target * (1 - Math.pow(1 - k, 3));
      el.textContent = v.toLocaleString("en-IN", { minimumFractionDigits: dec, maximumFractionDigits: dec });
      if (k < 1) requestAnimationFrame(step);
    };
    requestAnimationFrame(step);
  };

  const applyBuild = (slide: HTMLElement, upTo: number) => {
    slide.dataset.b = String(upTo);
    slide.querySelectorAll<HTMLElement | SVGElement>("[data-at]").forEach((el) => {
      const at = Number(el.getAttribute("data-at"));
      const out = el.getAttribute("data-out");
      const on = at <= upTo && (out === null || upTo < Number(out));
      const was = el.classList.contains("on");
      el.classList.toggle("on", on);
      if (on && !was) el.querySelectorAll<HTMLElement>("[data-count]").forEach(runCount);
      if (on && !was && el.matches("[data-count]")) runCount(el as HTMLElement);
    });
  };

  const show = (nextI: number, nextB: number) => {
    const changed = nextI !== i;
    i = nextI;
    b = nextB;
    slides.forEach((s, k) => {
      s.classList.toggle("is-active", k === i);
      s.classList.toggle("is-past", k < i);
      s.classList.toggle("is-future", k > i);
      if (k !== i) s.querySelectorAll(".on").forEach((el) => el.classList.remove("on"));
    });
    if (changed) {
      slides[i].querySelectorAll(".on").forEach((el) => el.classList.remove("on"));
      void slides[i].offsetWidth;
      requestAnimationFrame(() => applyBuild(slides[i], b));
    } else {
      applyBuild(slides[i], b);
    }
    count.textContent = `${i + 1} / ${total}`;
    dots.forEach((d, k) => {
      d.classList.toggle("cur", k === i);
      d.classList.toggle("done", k < i);
    });
    history.replaceState(null, "", `#${i + 1}`);
  };

  const next = () => {
    if (b < builds[i]) show(i, b + 1);
    else if (i < total - 1) show(i + 1, 0);
  };
  const prev = () => {
    if (b > 0) show(i, b - 1);
    else if (i > 0) show(i - 1, builds[i - 1]);
  };

  addEventListener("keydown", (e) => {
    if (e.metaKey || e.ctrlKey || e.altKey) return;
    if (["ArrowRight", "ArrowDown", "PageDown", " ", "Enter"].includes(e.key)) { e.preventDefault(); next(); }
    else if (["ArrowLeft", "ArrowUp", "PageUp", "Backspace"].includes(e.key)) { e.preventDefault(); prev(); }
    else if (e.key === "Home") show(0, 0);
    else if (e.key === "End") show(total - 1, builds[total - 1]);
    else if (e.key.toLowerCase() === "f") toggleFs();
  });

  stage.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a, button")) return;
    next();
  });

  let x0: number | null = null;
  addEventListener("pointerdown", (e) => { x0 = e.clientX; });
  addEventListener("pointerup", (e) => {
    if (x0 === null) return;
    const dx = e.clientX - x0;
    x0 = null;
    if (Math.abs(dx) > 60) (dx < 0 ? next : prev)();
  });

  document.getElementById("next")!.addEventListener("click", next);
  document.getElementById("prev")!.addEventListener("click", prev);
  dots.forEach((d) => d.addEventListener("click", () => show(Number(d.dataset.go), 0)));

  const toggleFs = () => {
    if (document.fullscreenElement) void document.exitFullscreen();
    else void document.documentElement.requestFullscreen?.();
  };
  document.getElementById("fs")!.addEventListener("click", toggleFs);

  let idle: number | undefined;
  const wake = () => {
    hud.classList.remove("idle");
    clearTimeout(idle);
    idle = window.setTimeout(() => hud.classList.add("idle"), 2800);
  };
  addEventListener("mousemove", wake);
  addEventListener("keydown", wake);
  wake();

  addEventListener("resize", fit);
  addEventListener("hashchange", () => {
    const n = Number(location.hash.slice(1)) - 1;
    if (n >= 0 && n < total && n !== i) show(n, 0);
  });

  fit();
  const start = Number(location.hash.slice(1)) - 1;
  show(start >= 0 && start < total ? start : 0, 0);
</script>
