AI26_BACKEND_PORT=8001
AI26_FRONTEND_PORT=5174
# Docker Compose host footage directory, published host interface, and backup retention:
# AI26_FOOTAGE_DIR=./backend/data/footage
# AI26_HOST=127.0.0.1
# AI26_BACKUP_KEEP=30
# Override only if the API runs on a different host/port:
# AI26_API_TARGET=http://127.0.0.1:8001
# Absolute directory containing grey-tata-videos/ and numberplate-vids/:
# AI26_FOOTAGE_ROOT=/absolute/path/to/your/footage

# One API process owns inference; total CPU sampling budget across all cameras:
AI26_TOTAL_INFERENCE_FPS=2
AI26_PROCESSING_ENABLED=1
AI26_TIMEZONE=Asia/Kolkata
# Database and raw-frame/crop storage (ignored by Git):
# AI26_DATA_ROOT=/absolute/path/to/ai26-data

# Managed recorded imports; same export must be used by importer and API:
# AI26_SOURCE_ROOT=/absolute/path/to/ai26-sources
