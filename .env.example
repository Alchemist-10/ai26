AI26_BACKEND_PORT=8001
AI26_FRONTEND_PORT=5174
# Docker Compose host footage directory, published host interface, and backup retention:
# AI26_FOOTAGE_DIR=./backend/data/footage
# AI26_HOST=127.0.0.1
# AI26_BACKUP_KEEP=30
# Optional Compose TLS overlay (certificate files stay outside Git):
# AI26_TLS_HOST=127.0.0.1
# AI26_HTTP_REDIRECT_PORT=8080
# AI26_TLS_PORT=8443
# AI26_TLS_CERT_FILE=/absolute/path/to/fullchain.pem
# AI26_TLS_KEY_FILE=/absolute/path/to/private-key.pem
# Optional report signing overlay (protect the private key; distribute public key separately):
# AI26_EVIDENCE_SIGNING_PRIVATE_KEY_FILE=/absolute/path/to/report-signing-private.pem
# AI26_EVIDENCE_SIGNING_KEY_ID=ai26-production-2026
# Optional privacy display mode (key file should be a protected 32+ byte random secret):
# AI26_PRIVACY_KEY_FILE=/absolute/path/to/ai26-privacy.key
# Optional authentication overlay (password file must be readable by container UID 10001):
# AI26_ADMIN_BOOTSTRAP_PASSWORD_FILE=/absolute/path/to/ai26-admin-bootstrap-password
# AI26_ADMIN_USERNAME=admin
# AI26_AUTH_COOKIE_SECURE=0
# Optional authenticator MFA key: 32 random bytes, owner UID 10001, mode 0400:
# AI26_AUTH_MFA_KEY_FILE=/absolute/path/to/ai26-auth-mfa.key
# Override only if the API runs on a different host/port:
# AI26_API_TARGET=http://127.0.0.1:8001
# Absolute directory containing grey-tata-videos/ and numberplate-vids/:
# AI26_FOOTAGE_ROOT=/absolute/path/to/your/footage

# One API process owns inference; total CPU sampling budget across all cameras:
AI26_TOTAL_INFERENCE_FPS=2
AI26_PROCESSING_ENABLED=1
# Disable one inference branch with 0; changes take effect after API restart.
AI26_VEHICLE_DETECTION_ENABLED=1
AI26_PLATE_RECOGNITION_ENABLED=1
AI26_TIMEZONE=Asia/Kolkata
# Database and raw-frame/crop storage (ignored by Git):
# AI26_DATA_ROOT=/absolute/path/to/ai26-data

# Managed recorded imports; same export must be used by importer and API:
# AI26_SOURCE_ROOT=/absolute/path/to/ai26-sources
